DB_PASSWORD=sua_senha_aqui

# URL do extrato do Brasil (Geofabrik). Baixado automaticamente pelo serviço
# importer na primeira subida, se ./data/brazil.osm.pbf ainda não existir.
# Para reproduzir exatamente o extrato usado no TCC (5 ago. 2026), use o
# arquivo datado em vez do "latest":
#PBF_URL=https://download.geofabrik.de/south-america/brazil-260805.osm.pbf

# Cache do osm2pgsql em MB (default 2048). Aumente se tiver RAM sobrando.
#OSM2PGSQL_CACHE=4096
